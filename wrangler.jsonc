{
  "name": "akashvetiver",
  "main": "server/worker.mjs",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/pieces/*",
      "/sitemap.xml",
      "/site-config.js"
    ],
    "not_found_handling": "404-page"
  },
  "vars": {
    "SUPABASE_PUBLISHABLE_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imxna2tqdWJ3ZHhkZnBtb3hrcm1kIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTI0MDgxNDEsImV4cCI6MjEwNzk4NDE0MX0.UxR713EnXbX_QjYKvJ7zn-3AW2uX2s_BzO_6vodDv_4",
    "ENABLE_CATALOG": "true",
    "ENABLE_SUBMISSIONS": "true",
    "ENABLE_NOTIFICATIONS": "false",
    "RESEND_FROM": "Akash Vetiver Export <notifications@akashvetiverexport.in>",
    "ENABLE_EDGE_RATE_LIMIT": "true"
  },
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "ratelimits": [
    {
      "name": "SUBMISSION_RATE_LIMITER",
      "namespace_id": "2026102801",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ]
}
